# Copie este arquivo para .env e preencha os valores.
# O arquivo .env nunca vai para o repositório.

# Obrigatória: chave da API da OpenAI (nunca comite a chave real)
OPENAI_API_KEY=

# Modelos (valores padrão do projeto)
MODELO_GERACAO=gpt-4o-mini
MODELO_EMBEDDING=text-embedding-3-small

# Recuperação
LIMIAR_SIMILARIDADE=0.35
TOP_K=4

# Documentos e processamento
PASTA_DOCUMENTOS=base_conhecimento
TAMANHO_MAXIMO_CHUNK=1200

# Chamadas à API
TIMEOUT_SEGUNDOS=30
